# 系统
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SOCKET_PORT=3001

# 数据库（SQLite，开箱即用；生产可切 PostgreSQL）
DATABASE_URL="file:./dev.db"

# 加密（API Key AES-256-GCM 存储）
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="personamate-dev-secret-change-in-production"

# 默认系统 AI（演示用，用户可自带 Key 覆盖）
DEFAULT_AI_PROVIDER=deepseek
DEFAULT_AI_BASE_URL=https://api.deepseek.com
DEFAULT_AI_API_KEY=sk-your-system-key
DEFAULT_AI_MODEL=deepseek-chat

# Embedding / Reranker（可指向本地或第三方端点）
EMBEDDING_BASE_URL=http://localhost:8000
EMBEDDING_MODEL=bge-m3
RERANKER_BASE_URL=http://localhost:8000
RERANKER_MODEL=bge-reranker-v2-m3

# 多模态（可选，留空则走模拟实现）
WHISPER_BASE_URL=
OCR_BASE_URL=
TTS_BASE_URL=
SD_BASE_URL=
EMOTION_MODEL_BASE_URL=

# 网易云音乐 API Enhanced
NETEASE_API_BASE=http://localhost:3000
NETEASE_COOKIE=

# Supabase Realtime（可选，默认走内置 Socket.io）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
